[Unit]
Description=APPly private PostgreSQL
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/apply

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/apply-postgres start
ExecStop=/usr/bin/docker stop --time 60 apply-postgres
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
