[Unit]
Description=APPly clinic background worker (guarded outbox recovery)
Requires=docker.service apply-postgres.service apply-api.service
BindsTo=apply-api.service
After=docker.service apply-postgres.service apply-api.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/apply
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
RuntimeDirectory=apply
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f apply-clinic-worker
ExecStart=/usr/local/sbin/apply-run worker
ExecStop=/usr/bin/docker stop --time 30 apply-clinic-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
