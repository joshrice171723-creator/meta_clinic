[Unit]
Description=APPly Rails API (isolated environment; clinic routes disabled)
Requires=docker.service apply-postgres.service
After=docker.service apply-postgres.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/apply
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
RuntimeDirectory=apply
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f apply-api
ExecStart=/usr/local/sbin/apply-run api
ExecStop=/usr/bin/docker stop --time 30 apply-api
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
