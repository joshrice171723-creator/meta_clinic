[Unit]
Description=APPly static frontend (no application credentials)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f apply-web
ExecStart=/usr/local/sbin/apply-run web
ExecStop=/usr/bin/docker stop --time 30 apply-web
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
