# Shared repository defaults. App-specific rules remain in each app's .gitignore.
# Ignore rules prevent accidental additions; they do not secure or untrack files.

# Local environments and credentials (only synthetic, secret-free examples belong in Git).
.env*
.dev.vars*
!.env.example
!.dev.vars.example
*.pem
*.key
*.p12
*.pfx
.aws/
.ssh/

# Dependencies, build output and caches.
node_modules/
vendor/bundle/
.bundle/
dist/
coverage/
.vite/
.cache/
__pycache__/
.pytest_cache/
*.py[cod]
*.tsbuildinfo

# Local runtime data, database sidecars and backups. Keep schema/migration SQL tracked.
*.log
*.pid
*.pid.lock
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.db
*.db-*
*.dump
*.dump.*
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
/tmp/
/log/
/storage/
/outputs/
/work/

# OS/editor scratch files. Shared Obsidian configuration stays tracked.
.DS_Store
._*
*.swp
*.swo
*~
