#!/usr/bin/env ruby
# Refresh the disposable APPly development checkout/database, then start it.
require "open3"
require "rbconfig"
require "socket"

ROOT = File.expand_path("..", __dir__)
API_ROOT = File.join(ROOT, "apps/api")

def fail_with(message)
  warn "startdev: #{message}"
  exit 1
end

def capture(*command, chdir: ROOT, environment: {})
  output, status = Open3.capture2e(environment, *command, chdir: chdir)
  [ output.strip, status.success? ]
end

def capture!(*command, chdir: ROOT, environment: {})
  output, success = capture(*command, chdir: chdir, environment: environment)
  fail_with("#{command.join(' ')} failed: #{output}") unless success
  output
end

def run!(*command, chdir: ROOT, environment: {})
  return if system(environment, *command, chdir: chdir)

  fail_with("#{command.join(' ')} failed")
end

def require_clean_checkout!
  status = capture!("git", "status", "--porcelain=v1", "--untracked-files=all")
  fail_with("the checkout is dirty; preserve and reconcile those changes before refreshing") unless status.empty?
end

def require_ports_available!
  [ 3000, 3001 ].each do |port|
    socket = TCPSocket.new("127.0.0.1", port)
    socket.close
    fail_with("port #{port} is still occupied after managed shutdown; do not kill an unowned process")
  rescue Errno::ECONNREFUSED, Errno::EHOSTUNREACH
    next
  end
end

if ARGV.delete("--help")
  puts "Usage: bin/startdev-refresh [--no-browser]"
  puts "Synchronize a clean checkout with its upstream, replant its local synthetic development database, and start APPly."
  exit 0
end

no_browser = ARGV.delete("--no-browser")
fail_with("unknown option: #{ARGV.first}") unless ARGV.empty?

require_clean_checkout!

branch, branch_ok = capture("git", "symbolic-ref", "--quiet", "--short", "HEAD")
fail_with("HEAD is detached; select the intended branch before refreshing") unless branch_ok && !branch.empty?

upstream, upstream_ok = capture("git", "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
fail_with("branch #{branch} has no configured upstream") unless upstream_ok && !upstream.empty?

remote = capture!("git", "config", "--get", "branch.#{branch}.remote")
fail_with("branch #{branch} does not track a remote repository") if remote.empty? || remote == "."

starting_commit = capture!("git", "rev-parse", "HEAD")
puts "Fetching #{remote} for #{branch} (upstream #{upstream})..."
run!("git", "fetch", remote)

counts = capture!("git", "rev-list", "--left-right", "--count", "HEAD...@{upstream}").split.map(&:to_i)
fail_with("could not compare HEAD with #{upstream}") unless counts.length == 2
ahead, behind = counts

if ahead.positive? && behind.positive?
  puts "Merging #{upstream} into #{branch} (ahead #{ahead}, behind #{behind})..."
  run!("git", "merge", "--no-edit", "@{upstream}")
elsif ahead.positive?
  puts "#{branch} is ahead of #{upstream} by #{ahead} commit(s); retaining clean local commits without pushing."
elsif behind.positive?
  puts "Fast-forwarding #{branch} by #{behind} commit(s)..."
  run!("git", "pull", "--ff-only")
end

require_clean_checkout!
final_counts = capture!("git", "rev-list", "--left-right", "--count", "HEAD...@{upstream}").split.map(&:to_i)
fail_with("checkout diverged from #{upstream} during reconciliation") unless final_counts.length == 2 && final_counts.last.zero?
final_commit = capture!("git", "rev-parse", "HEAD")

fail_with("DATABASE_URL must be unset for local refresh") unless ENV.fetch("DATABASE_URL", "").empty?
fail_with("RAILS_ENV must be unset or development") unless [ "", "development" ].include?(ENV.fetch("RAILS_ENV", ""))

database = ENV.fetch("APPLY_DEVELOPMENT_DATABASE", "apply_development")
unless database.match?(/\Aapply[a-z0-9_]*_development\z/)
  fail_with("development database #{database.inspect} is outside the allowed apply*_development namespace")
end

puts "Stopping the managed APPly stack..."
run!(RbConfig.ruby, File.join(ROOT, "dev_server_startup"), "stop")
require_ports_available!

local_environment = {
  "APP_SYNTHETIC_SEEDS" => nil,
  "APPLY_STARTDEV_SKIP_SCHEMA_DUMP" => "1",
  "DATABASE_URL" => nil,
  "RAILS_ENV" => "development"
}

puts "Starting the checkout-owned PostgreSQL container..."
run!(RbConfig.ruby, "bin/postgres", "start", chdir: API_ROOT, environment: local_environment)
run!(RbConfig.ruby, "bin/postgres", "exec", "bin/rails", "db:prepare",
  chdir: API_ROOT, environment: local_environment)

connection_guard = <<~'RUBY'
  expected = ENV.fetch("APPLY_DEVELOPMENT_DATABASE", "apply_development")
  config = ActiveRecord::Base.connection_db_config
  host = config.configuration_hash.fetch(:host).to_s
  safe = Rails.env.development? && config.database == expected && ["127.0.0.1", "localhost"].include?(host)
  abort "Refusing non-local development database: env=#{Rails.env} database=#{config.database} host=#{host}" unless safe
RUBY
run!(RbConfig.ruby, "bin/postgres", "exec", "bin/rails", "runner", connection_guard,
  chdir: API_ROOT, environment: local_environment)

puts "Replanting #{database} with wholly synthetic seed data..."
seed_environment = local_environment.merge("APP_SYNTHETIC_SEEDS" => "1")
run!(RbConfig.ruby, "bin/postgres", "exec", "bin/rails", "db:seed:replant",
  chdir: API_ROOT, environment: seed_environment)

puts "Starting and verifying the managed APPly stack..."
start_command = [ RbConfig.ruby, File.join(ROOT, "dev_server_startup"), "start" ]
start_command << "--no-browser" if no_browser
run!(*start_command)
run!(RbConfig.ruby, File.join(ROOT, "dev_server_startup"), "status")

puts "APPly refresh complete: #{starting_commit} -> #{final_commit}; replanted #{database}."
