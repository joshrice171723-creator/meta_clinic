#!/usr/bin/env ruby
# frozen_string_literal: true

# Compatibility shim. Refresh is now non-destructive and never auto-merges.
require "rbconfig"

root = File.expand_path("..", __dir__)
exec(RbConfig.ruby, File.join(root, "bin/dev"), "help", chdir: root) if ARGV.any? { |argument| %w[help --help -h].include?(argument) }
warn "bin/startdev-refresh is deprecated; use bin/dev refresh."
exec(RbConfig.ruby, File.join(root, "bin/dev"), "refresh", *ARGV, chdir: root)
