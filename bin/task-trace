#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "lib/task_trace"

def usage(message = nil)
  warn message if message
  puts <<~USAGE
    Usage:
      bin/task-trace start NAME
      bin/task-trace begin TRACE CATEGORY NAME
      bin/task-trace end TRACE SPAN_ID [ok|failed|interrupted]
      bin/task-trace span TRACE CATEGORY NAME -- COMMAND [ARG...]
      bin/task-trace finish TRACE [ok|failed|interrupted]
      bin/task-trace summary TRACE

    Trace files contain labels, categories, timing, and status only. Commands,
    environment variables, and command output are never recorded.
  USAGE
  exit(message ? 1 : 0)
end

begin
  command = ARGV.shift
  usage if command.nil? || %w[help --help -h].include?(command)

  case command
  when "start"
    usage("A task name is required.") if ARGV.empty?
    recorder = Apply::TaskTrace.start(
      name: ARGV.join(" "),
      output_root: File.expand_path("../tmp/task-traces", __dir__),
      source: "bin/task-trace"
    )
    puts recorder.path
  when "begin"
    trace_path = ARGV.shift
    category = ARGV.shift
    usage("TRACE, CATEGORY, and NAME are required.") unless trace_path && category && !ARGV.empty?
    puts Apply::TaskTrace.open(trace_path).start_span(name: ARGV.join(" "), category: category)
  when "end"
    trace_path = ARGV.shift
    span_id = ARGV.shift
    status = ARGV.shift || "ok"
    usage("TRACE and SPAN_ID are required.") unless trace_path && span_id && ARGV.empty?
    Apply::TaskTrace.open(trace_path).finish_span(span_id, status: status)
  when "span"
    separator = ARGV.index("--")
    usage("Use: bin/task-trace span TRACE CATEGORY NAME -- COMMAND [ARG...]") unless separator
    trace_path = ARGV.shift
    category = ARGV.shift
    label_parts = ARGV.shift(separator - 2)
    ARGV.shift
    usage("TRACE, CATEGORY, NAME, and COMMAND are required.") unless trace_path && category && !label_parts.empty? && !ARGV.empty?
    recorder = Apply::TaskTrace.open(trace_path)
    span_id = recorder.start_span(name: label_parts.join(" "), category: category)
    success = system(
      {"APPLY_TASK_TRACE" => recorder.path, "APPLY_TASK_TRACE_PARENT" => span_id},
      *ARGV
    )
    recorder.finish_span(span_id, status: success ? "ok" : "failed")
    exit(success ? 0 : 1)
  when "finish"
    trace_path = ARGV.shift
    status = ARGV.shift || "ok"
    usage("TRACE is required.") unless trace_path && ARGV.empty?
    recorder = Apply::TaskTrace.open(trace_path)
    artifact = recorder.finish(status: status)
    puts recorder.summary
    puts "Timeline: #{artifact}"
    puts "Trace: #{recorder.path}"
  when "summary"
    trace_path = ARGV.shift
    usage("TRACE is required.") unless trace_path && ARGV.empty?
    puts Apply::TaskTrace.open(trace_path).summary
  else
    usage("Unknown command: #{command}")
  end
rescue Apply::TaskTrace::TraceError => error
  warn "task-trace: #{error.message}"
  exit 1
end
