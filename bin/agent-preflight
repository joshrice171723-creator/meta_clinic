#!/usr/bin/env python3
"""Report a Shortcut claim, worktree state, instructions and context routes."""

from __future__ import annotations

import argparse
import fnmatch
import json
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
ROUTES = ROOT / "agent-harness" / "routes.json"


def git(*args: str) -> str:
    result = subprocess.run(
        ["git", *args],
        cwd=ROOT,
        check=True,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    return result.stdout.rstrip()


def target_directory(raw_path: str) -> tuple[Path, str]:
    candidate = Path(raw_path)
    if not candidate.is_absolute():
        candidate = ROOT / candidate
    candidate = candidate.resolve(strict=False)
    try:
        relative = candidate.relative_to(ROOT)
    except ValueError as error:
        raise ValueError(f"target is outside the repository: {raw_path}") from error

    if candidate.exists():
        directory = candidate if candidate.is_dir() else candidate.parent
    elif candidate.suffix:
        directory = candidate.parent
    else:
        directory = candidate
    return directory, relative.as_posix() or "."


def instruction_chain(directory: Path) -> list[Path]:
    try:
        relative = directory.relative_to(ROOT)
    except ValueError as error:
        raise ValueError(f"directory is outside the repository: {directory}") from error

    directories = [ROOT]
    current = ROOT
    for part in relative.parts:
        current /= part
        directories.append(current)

    instructions: list[Path] = []
    for candidate_directory in directories:
        override = candidate_directory / "AGENTS.override.md"
        standard = candidate_directory / "AGENTS.md"
        if override.is_file():
            instructions.append(override)
        elif standard.is_file():
            instructions.append(standard)
    return instructions


def route_manifest() -> dict[str, object]:
    try:
        manifest = json.loads(ROUTES.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"cannot load {ROUTES.relative_to(ROOT)}: {error}") from error
    if manifest.get("version") != 1:
        raise ValueError(f"{ROUTES.relative_to(ROOT)}: unsupported route-manifest version")
    if not isinstance(manifest.get("routes"), list) or not isinstance(manifest.get("fallback"), dict):
        raise ValueError(f"{ROUTES.relative_to(ROOT)}: routes and fallback are required")
    workflow = manifest.get("coordination_workflow")
    if not isinstance(workflow, str) or not (ROOT / workflow).is_file():
        raise ValueError(f"{ROUTES.relative_to(ROOT)}: valid coordination_workflow is required")
    return manifest


def route_for(relative_path: str, manifest: dict[str, object]) -> tuple[dict[str, object], bool]:
    for route in manifest["routes"]:
        if not isinstance(route, dict):
            continue
        patterns = route.get("patterns", [])
        if isinstance(patterns, list) and any(
            isinstance(pattern, str) and fnmatch.fnmatchcase(relative_path, pattern)
            for pattern in patterns
        ):
            return route, False
    return manifest["fallback"], True


def story_reference(raw: str) -> str:
    """Normalize an sc-123, numeric ID or Shortcut Story URL for traceability."""
    value = raw.strip()
    match = re.fullmatch(r"(?:sc-)?(\d+)", value, re.IGNORECASE)
    if not match:
        match = re.search(r"/story/(\d+)(?:/|$)", value)
    if not match:
        raise ValueError(f"invalid Shortcut Story reference {raw!r}; expected sc-123, 123 or a Story URL")
    return f"sc-{int(match.group(1))}"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--path",
        action="append",
        default=[],
        help="Repository-relative target path; repeat for multiple areas.",
    )
    parser.add_argument(
        "--story",
        help="Claimed Shortcut Story (for example sc-123). Required by policy before repository writes.",
    )
    args = parser.parse_args()
    paths = args.path or ["."]
    try:
        manifest = route_manifest()
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2

    story: str | None = None
    if args.story:
        try:
            story = story_reference(args.story)
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            return 2

    print(f"Repository: {ROOT}")
    print(f"Branch: {git('branch', '--show-current') or '(detached HEAD)'}")
    print(f"HEAD: {git('rev-parse', '--short=12', 'HEAD')}")
    status = git("status", "--short")
    print("Worktree:")
    print(status if status else "  clean")
    print(f"Coordination workflow: {manifest['coordination_workflow']}")
    if story:
        print(f"Shortcut Story: {story} (claim/state must be verified through Shortcut MCP)")
    else:
        print("Shortcut Story: (not supplied; repository-changing work must claim one before writing)")

    for raw_path in paths:
        try:
            directory, relative = target_directory(raw_path)
            instructions = instruction_chain(directory)
            route, fallback = route_for(relative, manifest)
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            return 2

        print(f"\nTarget: {relative}")
        print("Instruction chain:")
        for instruction in instructions:
            print(f"  - {instruction.relative_to(ROOT)}")
        suffix = " (fallback; no specialized route matched)" if fallback else ""
        print(f"Route: {route.get('name', 'unnamed')}{suffix}")
        for label, key in (
            ("Workflows", "workflows"),
            ("Skills", "skills"),
            ("Developer documentation", "developer_docs"),
            ("Vault context", "vault_context"),
            ("Checks", "checks"),
        ):
            values = route.get(key, [])
            print(f"{label}:")
            if isinstance(values, list) and values:
                for value in values:
                    print(f"  - {value}")
            else:
                print("  - (none)")

    print("\nBefore writing, verify the Story is In Progress with the current claim, then state the reviewed scope, material gaps/conflicts and intended changes.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
