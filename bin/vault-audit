#!/usr/bin/env python3
"""Report APPly vault size, lifecycle, routing and identifier hygiene."""

from __future__ import annotations

import argparse
import re
import sys
from collections import Counter, defaultdict
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
VAULT = ROOT / "APPlyVault"
WIKI_LINK = re.compile(r"!?\[\[([^\]]+)\]\]")
FRONTMATTER_KEY = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*?)\s*$")
SOURCE_ID = re.compile(r"^\|\s*(S-\d+)\s*\|", re.MULTILINE)
TASK_ID = re.compile(r"^\|\s*(T-\d+(?:\.\d+)*)\s*\|", re.MULTILINE)
SHELL_FENCE = re.compile(r"^```(?:sh|bash|shell|powershell)\s*$", re.MULTILINE)
AGENT_PROCEDURE = re.compile(
    r"\b(?:bin/agent-(?:preflight|check)|AGENTS\.md|agent-harness/workflows|"
    r"\$(?:plan|act|startdev|frontend-ui)|Codex users? may)\b",
    re.IGNORECASE,
)


def frontmatter(text: str) -> dict[str, str]:
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        return {}
    try:
        end = lines.index("---", 1)
    except ValueError:
        return {}
    values: dict[str, str] = {}
    for line in lines[1:end]:
        if match := FRONTMATTER_KEY.match(line):
            values[match.group(1)] = match.group(2).strip("'\"")
    return values


def wiki_target(raw: str) -> str:
    target = raw.split("|", 1)[0].split("#", 1)[0].removesuffix(".md")
    return target.strip().casefold()


def duplicate_definitions(
    paths: list[Path], texts: dict[Path, str], pattern: re.Pattern[str]
) -> dict[str, list[Path]]:
    occurrences: dict[str, list[Path]] = defaultdict(list)
    for path in paths:
        for identifier in pattern.findall(texts[path]):
            occurrences[identifier].append(path)
    return {
        identifier: locations
        for identifier, locations in occurrences.items()
        if len(locations) > 1
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--strict",
        action="store_true",
        help="Fail for duplicate definitions or active notes above the hard size limit.",
    )
    parser.add_argument("--soft-bytes", type=int, default=25_000)
    parser.add_argument("--hard-bytes", type=int, default=64_000)
    args = parser.parse_args()

    paths = sorted(path for path in VAULT.rglob("*.md") if path.name != "AGENTS.md")
    texts = {path: path.read_text(encoding="utf-8") for path in paths}
    total = sum(path.stat().st_size for path in paths)
    archived = [
        path
        for path in paths
        if frontmatter(texts[path]).get("lifecycle") in {"archived", "superseded"}
        or "archive" in {part.casefold() for part in path.parts}
    ]
    active = [path for path in paths if path not in archived]

    print(
        f"Vault hygiene: {len(active)} active notes / {sum(path.stat().st_size for path in active)} bytes; "
        f"{len(archived)} archived notes; {len(paths)} total notes / {total} bytes."
    )

    oversized = [
        (path.stat().st_size, path)
        for path in active
        if path.stat().st_size > args.soft_bytes
    ]
    if oversized:
        print("\nActive notes above the soft size budget:")
        for size, path in sorted(oversized, reverse=True):
            level = "HARD" if size > args.hard_bytes else "soft"
            print(f"  - {level:4} {size:>7}  {path.relative_to(ROOT)}")

    missing_lifecycle = [
        path for path in paths if "lifecycle" not in frontmatter(texts[path])
    ]
    print(f"\nLifecycle metadata missing: {len(missing_lifecycle)} notes.")

    by_stem = {path.stem.casefold(): path for path in paths}
    inbound = Counter()
    for text in texts.values():
        for raw in WIKI_LINK.findall(text):
            if (target := wiki_target(raw)) in by_stem:
                inbound[by_stem[target]] += 1
    weak = [path for path in active if inbound[path] == 0 and path.name != "00 Home.md"]
    if weak:
        print("\nActive notes with no inbound wiki link:")
        for path in weak:
            print(f"  - {path.relative_to(ROOT)}")

    procedural = [
        path
        for path in active
        if frontmatter(texts[path]).get("type")
        not in {
            "dashboard",
            "index",
            "source-register",
            "decision-log",
            "progress-log",
            "operating-agreement",
        }
        and (AGENT_PROCEDURE.search(texts[path]) or SHELL_FENCE.search(texts[path]))
    ]
    if procedural:
        print("\nActive vault notes with agent-procedure or shell-command signals:")
        for path in procedural:
            print(f"  - {path.relative_to(ROOT)}")

    duplicates: dict[str, list[Path]] = {}
    for pattern in (SOURCE_ID, TASK_ID):
        duplicates.update(duplicate_definitions(paths, texts, pattern))
    if duplicates:
        print("\nDuplicate identifier definitions:")
        for identifier, locations in sorted(duplicates.items()):
            rendered = ", ".join(str(path.relative_to(ROOT)) for path in locations)
            print(f"  - {identifier}: {rendered}")

    hard_failures = [
        path for size, path in oversized if size > args.hard_bytes
    ]
    if args.strict and (duplicates or hard_failures):
        print("\nStrict vault hygiene failed.", file=sys.stderr)
        return 1

    print("\nAdvisory only; review findings before moving, compacting or deleting content.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
