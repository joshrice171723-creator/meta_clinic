#!/usr/bin/env python3
"""Validate APPly vault notes and the repository agent-instruction layout."""

from __future__ import annotations

import os
import re
import sys
import urllib.parse
from collections import defaultdict, deque
from datetime import date
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
VAULT = ROOT / "APPlyVault"
WIKI_LINK = re.compile(r"!?\[\[([^\]]+)\]\]")
MARKDOWN_LINK = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*$")
FRONTMATTER_KEY = re.compile(r"^([A-Za-z0-9_-]+):\s*(.*?)\s*$")
ISO_DATE = re.compile(r"^\d{4}-\d{2}-\d{2}$")

REQUIRED_INSTRUCTION_FILES = [
    "AGENTS.md",
    "APPlyVault/AGENTS.md",
    "apps/api/AGENTS.md",
    "apps/web/AGENTS.md",
    "ops/aws/AGENTS.md",
    "site/AGENTS.md",
    "agent-workflows/README.md",
    "agent-workflows/code-change.md",
    "agent-workflows/vault-change.md",
    "agent-workflows/database-change.md",
    "agent-workflows/research.md",
    "agent-workflows/release.md",
    "agent-workflows/incident.md",
    "agent-workflows/handoff.md",
    ".clinerules/00-canonical.md",
    ".clinerules/vault.md",
    ".clinerules/api.md",
    ".clinerules/web.md",
    ".clinerules/aws.md",
    ".clinerules/site.md",
]


def heading_key(value: str) -> str:
    value = re.sub(r"\s+#+\s*$", "", value)
    value = re.sub(r"\{#[-\w]+\}\s*$", "", value)
    value = re.sub(r"[`*_~]", "", value)
    value = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", value)
    return " ".join(value.casefold().split())


def headings_for(text: str) -> set[str]:
    return {
        heading_key(match.group(1))
        for line in text.splitlines()
        if (match := HEADING.match(line))
    }


def parse_frontmatter(path: Path, text: str, errors: list[str]) -> None:
    lines = text.splitlines()
    label = path.relative_to(ROOT)
    if not lines or lines[0] != "---":
        errors.append(f"{label}: missing opening frontmatter fence")
        return
    try:
        end = lines.index("---", 1)
    except ValueError:
        errors.append(f"{label}: missing closing frontmatter fence")
        return
    values: dict[str, str] = {}
    for line in lines[1:end]:
        if match := FRONTMATTER_KEY.match(line):
            values[match.group(1)] = match.group(2).strip('"\'')
    for key in ("type", "status", "updated"):
        if not values.get(key):
            errors.append(f"{label}: missing frontmatter key {key}")
    updated = values.get("updated", "")
    if updated and not ISO_DATE.fullmatch(updated):
        errors.append(f"{label}: updated must be ISO date, got {updated!r}")
    elif updated:
        try:
            date.fromisoformat(updated)
        except ValueError:
            errors.append(f"{label}: invalid updated date {updated!r}")


def check_fences(path: Path, text: str, errors: list[str]) -> None:
    active: str | None = None
    for line in text.splitlines():
        stripped = line.lstrip()
        marker = stripped[:3]
        if marker not in {"```", "~~~"}:
            continue
        if active is None:
            active = marker
        elif marker == active:
            active = None
    if active:
        errors.append(f"{path.relative_to(ROOT)}: unclosed {active} fence")


def check_cline_rule(path: Path, text: str, errors: list[str]) -> None:
    if path.name == "00-canonical.md":
        return
    lines = text.splitlines()
    if not lines or lines[0] != "---":
        errors.append(f"{path.relative_to(ROOT)}: missing conditional-rule frontmatter")
        return
    try:
        end = lines.index("---", 1)
    except ValueError:
        errors.append(f"{path.relative_to(ROOT)}: unclosed conditional-rule frontmatter")
        return
    frontmatter = lines[1:end]
    if "paths:" not in frontmatter or not any(line.lstrip().startswith("- ") for line in frontmatter):
        errors.append(f"{path.relative_to(ROOT)}: conditional rule must declare at least one path")


def clean_link_target(raw: str) -> str:
    target = raw.strip()
    if target.startswith("<") and ">" in target:
        target = target[1 : target.index(">")]
    else:
        target = target.split(" ", 1)[0]
    return urllib.parse.unquote(target)


def resolve_wiki_target(
    source: Path,
    raw: str,
    by_stem: dict[str, Path],
    by_relative: dict[str, Path],
) -> tuple[Path | None, str | None]:
    target = raw.split("|", 1)[0].strip()
    note_part, separator, heading = target.partition("#")
    note_part = note_part.removesuffix(".md").strip()
    if not note_part:
        note = source
    elif "/" in note_part:
        note = by_relative.get(note_part.casefold())
        if note is None:
            candidate = (source.parent / f"{note_part}.md").resolve(strict=False)
            note = candidate if candidate.is_file() else None
    else:
        note = by_stem.get(note_part.casefold())
    return note, heading.strip() if separator else None


def check_markdown_links(path: Path, text: str, errors: list[str]) -> None:
    for match in MARKDOWN_LINK.finditer(text):
        target = clean_link_target(match.group(1))
        if not target or target.startswith(("http://", "https://", "mailto:", "app://")):
            continue
        file_part, separator, anchor = target.partition("#")
        destination = path if not file_part else (path.parent / file_part).resolve(strict=False)
        if not destination.exists():
            errors.append(f"{path.relative_to(ROOT)}: missing relative link target {target!r}")
            continue
        if separator and destination.is_file() and destination.suffix.casefold() == ".md":
            destination_text = destination.read_text(encoding="utf-8")
            if heading_key(anchor) not in headings_for(destination_text):
                errors.append(
                    f"{path.relative_to(ROOT)}: missing heading {anchor!r} in {destination.relative_to(ROOT)}"
                )


def main() -> int:
    errors: list[str] = []
    note_paths = sorted(
        path for path in VAULT.rglob("*.md") if path.name not in {"AGENTS.md"}
    )
    note_text = {path: path.read_text(encoding="utf-8") for path in note_paths}

    by_stem_lists: dict[str, list[Path]] = defaultdict(list)
    by_relative: dict[str, Path] = {}
    for path in note_paths:
        by_stem_lists[path.stem.casefold()].append(path)
        relative_without_suffix = path.relative_to(VAULT).with_suffix("").as_posix().casefold()
        by_relative[relative_without_suffix] = path
    for stem, paths in sorted(by_stem_lists.items()):
        if len(paths) > 1:
            rendered = ", ".join(str(path.relative_to(ROOT)) for path in paths)
            errors.append(f"duplicate vault note name {stem!r}: {rendered}")
    by_stem = {stem: paths[0] for stem, paths in by_stem_lists.items() if len(paths) == 1}
    note_headings = {path: headings_for(text) for path, text in note_text.items()}

    graph: dict[Path, set[Path]] = defaultdict(set)
    wiki_count = 0
    for path, text in note_text.items():
        parse_frontmatter(path, text, errors)
        check_fences(path, text, errors)
        check_markdown_links(path, text, errors)
        for match in WIKI_LINK.finditer(text):
            wiki_count += 1
            note, heading = resolve_wiki_target(path, match.group(1), by_stem, by_relative)
            if note is None or note not in note_text:
                errors.append(f"{path.relative_to(ROOT)}: missing wiki target {match.group(1)!r}")
                continue
            graph[path].add(note)
            if heading and not heading.startswith("^") and heading_key(heading) not in note_headings[note]:
                errors.append(
                    f"{path.relative_to(ROOT)}: missing wiki heading {heading!r} in {note.relative_to(ROOT)}"
                )

    home = VAULT / "00 Home.md"
    visited: set[Path] = set()
    queue: deque[Path] = deque([home])
    while queue:
        current = queue.popleft()
        if current in visited:
            continue
        visited.add(current)
        queue.extend(graph[current] - visited)
    for path in note_paths:
        if path not in visited:
            errors.append(f"{path.relative_to(ROOT)}: note is not reachable from APPlyVault/00 Home.md")

    for relative in REQUIRED_INSTRUCTION_FILES:
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"missing required instruction/workflow file: {relative}")

    root_agents = ROOT / "AGENTS.md"
    if root_agents.is_file() and root_agents.stat().st_size > 12_000:
        errors.append(
            f"AGENTS.md is {root_agents.stat().st_size} bytes; keep the always-loaded root contract at or below 12000"
        )

    instruction_documents = [
        ROOT / relative
        for relative in REQUIRED_INSTRUCTION_FILES
        if (ROOT / relative).is_file()
    ]
    for path in instruction_documents:
        text = path.read_text(encoding="utf-8")
        check_fences(path, text, errors)
        check_markdown_links(path, text, errors)
        if path.parent == ROOT / ".clinerules":
            check_cline_rule(path, text, errors)

    for relative in ("bin/agent-preflight", "bin/agent-check", "bin/verify-vault"):
        path = ROOT / relative
        if not path.is_file():
            errors.append(f"missing agent workflow command: {relative}")
        elif not os.access(path, os.X_OK):
            errors.append(f"agent workflow command is not executable: {relative}")

    if errors:
        print("Vault/instruction verification failed:", file=sys.stderr)
        for error in sorted(set(errors)):
            print(f"  - {error}", file=sys.stderr)
        return 1

    print(
        f"Verified {len(note_paths)} vault notes, {wiki_count} wiki links, "
        f"{len(instruction_documents)} instruction/workflow files and Home reachability."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
