#!/usr/bin/env python3
"""Focused tests for CI selection; no application or provider access."""
import runpy
import subprocess
import unittest
from pathlib import Path
from unittest.mock import patch

scope = runpy.run_path(str(Path(__file__).with_name("ci-change-scope")))
classify = scope["classify"]


class ScopeTests(unittest.TestCase):
    def test_docs_only(self):
        self.assertEqual(classify(["docs/development/ci.md", "AGENTS.md"]),
                         dict(full=False, backend=False, frontend=False))

    def test_web_test_only(self):
        self.assertEqual(classify(["apps/web/test/recall.test.tsx"]),
                         dict(full=False, backend=False, frontend=True))

    def test_backend_test_only(self):
        self.assertEqual(classify(["apps/api/test/fixtures/appointments.yml"]),
                         dict(full=False, backend=True, frontend=False))

    def test_production_and_unknown_keep_all_gates(self):
        for path in ["apps/web/src/main.tsx", "apps/api/db/schema.rb", "bin/dev",
                     ".github/workflows/ci.yml", "apps/web/public/clinical.md"]:
            with self.subTest(path=path):
                self.assertTrue(all(classify([path]).values()))

    def test_manual_and_mixed(self):
        self.assertTrue(all(classify([], full=True).values()))
        self.assertEqual(classify(["docs/a.md", "apps/web/test/a.ts", "apps/api/test/a.rb"]),
                         dict(full=False, backend=True, frontend=True))

    def test_rename_counts_both_paths_and_handles_newline(self):
        with patch("subprocess.check_output", return_value=b"apps/web/src/a.ts\0apps/web/test/a\n.ts\0") as call:
            paths = scope["changed_paths"]("base", "head")
        self.assertIn("--no-renames", call.call_args.args[0])
        self.assertTrue(all(classify(paths).values()))

    def test_missing_history_fails_to_full(self):
        with patch("sys.argv", ["ci-change-scope", "--base", "missing"]), \
             patch("subprocess.check_output", side_effect=subprocess.CalledProcessError(128, "git")), \
             patch("builtins.print") as output:
            scope["main"]()
        self.assertIn('"full": true', output.call_args.args[0])


if __name__ == "__main__":
    unittest.main()
