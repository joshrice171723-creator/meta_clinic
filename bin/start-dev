#!/usr/bin/env ruby
# Cross-platform local startup for macOS/Linux. Synthetic development only.
require "fileutils"
require "net/http"
require "open3"
require "shellwords"
require "socket"
require "timeout"
require "uri"

root = File.expand_path("..", __dir__)
api_root = File.join(root, "apps/api")
web_root = File.join(root, "apps/web")
runtime_root = File.join(root, "tmp/dev")
log_root = File.join(runtime_root, "logs")
pid_root = File.join(runtime_root, "pids")
container = ENV.fetch("APPLY_POSTGRES_CONTAINER", "apply-postgres-development")
seed = ARGV.delete("--seed")
no_browser = ARGV.delete("--no-browser")
no_docker_start = ARGV.delete("--no-docker-start")
daemon = ARGV.delete("--daemon")

abort "Unknown option: #{ARGV.first}" unless ARGV.empty?
FileUtils.mkdir_p(log_root)
FileUtils.mkdir_p(pid_root)

def command_available?(command)
  system("sh", "-c", "command -v #{Shellwords.escape(command)} >/dev/null 2>&1")
end

def port_in_use?(port)
  socket = TCPServer.new("127.0.0.1", port)
  socket.close
  false
rescue Errno::EADDRINUSE
  true
end

def run!(*command, chdir: nil)
  options = {}
  options[:chdir] = chdir if chdir
  output, status = Open3.capture2e(*command, **options)
  abort output unless status.success?
end

def managed_process?(path)
  pid = Integer(File.read(path).strip, 10)
  Process.kill(0, pid)
  true
rescue Errno::ENOENT, Errno::ESRCH, ArgumentError
  false
end

def require_managed_or_available_port!(port, pid_path)
  return unless port_in_use?(port)
  return if managed_process?(pid_path)

  abort "Port #{port} is already in use by a process not managed by this APPly checkout. Stop or relocate that process, then retry."
end

def http_ready?(url)
  uri = URI(url)
  response = Net::HTTP.start(uri.host, uri.port, open_timeout: 2, read_timeout: 3) do |http|
    http.get(uri.request_uri)
  end
  response.code.to_i == 200
rescue SystemCallError, Timeout::Error, Net::OpenTimeout, Net::ReadTimeout
  false
end

def wait_until(timeout_seconds)
  deadline = Time.now + timeout_seconds
  loop do
    return true if yield
    return false if Time.now >= deadline
    sleep 1
  end
end

def start_docker_if_possible
  return unless RUBY_PLATFORM.match?("darwin")
  system("open", "-a", "Docker")
end

abort "Docker CLI was not found on PATH. Install Docker Desktop or Docker Engine, then reopen your terminal." unless command_available?("docker")

docker_ready = system("docker", "info", out: File::NULL, err: File::NULL)
if !docker_ready && !no_docker_start
  start_docker_if_possible
  puts RUBY_PLATFORM.match?("darwin") ? "Waiting for Docker Desktop..." : "Docker is not running. Start Docker, then retry."
  docker_ready = wait_until(90) { system("docker", "info", out: File::NULL, err: File::NULL) }
end
abort "Docker is not running. Start Docker and retry (or use --no-docker-start for an immediate check)." unless docker_ready

require_managed_or_available_port!(3001, File.join(pid_root, "api.pid"))
require_managed_or_available_port!(3000, File.join(pid_root, "web.pid"))

container_exists = system("docker", "container", "inspect", container, out: File::NULL, err: File::NULL)
if !container_exists
  run!("ruby", "bin/postgres", "start", chdir: api_root)
elsif `docker inspect --format '{{.State.Running}}' #{Shellwords.escape(container)}`.strip != "true"
  puts "Starting the existing local PostgreSQL container..."
  run!("docker", "start", container)
end

puts "Waiting for PostgreSQL..."
database_ready = wait_until(45) do
  system("docker", "exec", container, "pg_isready", "-U", "postgres", "-d", "postgres", out: File::NULL, err: File::NULL)
end
abort "PostgreSQL did not become ready. Check: docker logs #{container}" unless database_ready

puts "Preparing the development database..."
run!("ruby", "bin/postgres", "exec", "bundle", "exec", "rails", "db:prepare", chdir: api_root)
if seed
  seed_environment = { "APP_SYNTHETIC_SEEDS" => "1", "APP_DEVELOPMENT_LOGIN" => "1" }
  run!(seed_environment, "ruby", "bin/postgres", "exec", "bundle", "exec", "rails", "db:seed", chdir: api_root)
  run!(seed_environment, "ruby", "bin/postgres", "exec", "bundle", "exec", "rails", "members:prepare_test_accounts", chdir: api_root)
end

children = []
environment = { "APP_DEVELOPMENT_LOGIN" => "1" }
ready = false
begin
  unless port_in_use?(3001)
    api_log = File.open(File.join(log_root, "api.log"), "a")
    children << Process.spawn(environment, "ruby", "bin/postgres", "exec", "bundle", "exec", "rails", "server", "-b", "127.0.0.1", "-p", "3001", chdir: api_root, pgroup: true, out: api_log, err: api_log)
    File.write(File.join(pid_root, "api.pid"), children.last)
  end
  unless port_in_use?(3000)
    web_log = File.open(File.join(log_root, "web.log"), "a")
    children << Process.spawn("npm", "run", "dev", chdir: web_root, pgroup: true, out: web_log, err: web_log)
    File.write(File.join(pid_root, "web.pid"), children.last)
  end

  abort "API failed readiness. See #{log_root}/api.log" unless wait_until(45) { http_ready?("http://127.0.0.1:3001/up") }
  abort "Frontend failed readiness. See #{log_root}/web.log" unless wait_until(60) { http_ready?("http://127.0.0.1:3000/login") }
  puts "APPly is ready: http://127.0.0.1:3000/login"
  puts "API health: http://127.0.0.1:3001/up"
  puts "Logs: #{log_root}"
  unless no_browser
    if RUBY_PLATFORM.match?("darwin")
      system("open", "http://127.0.0.1:3000/login")
    elsif command_available?("xdg-open")
      system("xdg-open", "http://127.0.0.1:3000/login", out: File::NULL, err: File::NULL)
    end
  end
  ready = true
  exit 0 if daemon
rescue Interrupt
  exit 0
ensure
  unless ready
    children.each do |pid|
      Process.kill("TERM", -pid)
    rescue Errno::ESRCH
      nil
    end
    children.each do |pid|
      Process.wait(pid)
    rescue Errno::ECHILD
      nil
    end
  end
end
