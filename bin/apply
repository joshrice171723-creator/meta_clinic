#!/usr/bin/env ruby
# APPly local lifecycle command. Synthetic development only.
require "fileutils"
require "open3"
require "rbconfig"

root = File.expand_path("..", __dir__)
api_root = File.join(root, "apps/api")
runtime_root = File.join(root, "tmp/dev")
pid_root = File.join(runtime_root, "pids")
container = ENV.fetch("APPLY_POSTGRES_CONTAINER", "apply-postgres-development")
command = ARGV.shift

def fail_with(message)
  warn "apply: #{message}"
  exit 1
end

def run!(*args, chdir: nil)
  output, status = Open3.capture2e(*args, chdir: chdir)
  fail_with(output.strip) unless status.success?
end

def kill_pid(pid)
  if Gem.win_platform?
    system("taskkill", "/PID", pid.to_s, "/T", "/F", out: File::NULL, err: File::NULL)
  else
    begin
      Process.kill("TERM", -pid)
    rescue Errno::ESRCH
      begin
        Process.kill("TERM", pid)
      rescue Errno::ESRCH
        nil
      end
    end
  end
end

def pid_files(pid_root)
  Dir[File.join(pid_root, "*.pid")]
end

def remove_pid_files(pid_root)
  pid_files(pid_root).each { |path| File.delete(path) rescue nil }
end

case command
when "up"
  FileUtils.mkdir_p(pid_root)
  if Gem.win_platform?
    script = File.join(root, "bin/start-dev.ps1")
    args = ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", script]
    args << "-Seed" if ARGV.delete("--seed")
    args << "-NoBrowser" if ARGV.delete("--no-browser")
    fail_with("Unknown option: #{ARGV.first}") unless ARGV.empty?
    Process.spawn("powershell", *args, chdir: root, creationflags: 0x00000008)
  else
    args = [File.join(root, "bin/start-dev"), "--daemon"]
    args << "--seed" if ARGV.delete("--seed")
    args << "--no-browser" if ARGV.delete("--no-browser")
    args << "--no-docker-start" if ARGV.delete("--no-docker-start")
    fail_with("Unknown option: #{ARGV.first}") unless ARGV.empty?
    Process.spawn("ruby", *args, chdir: root, pgroup: true)
  end
  puts "APPly startup requested. Run `apply doctor` to check readiness."
when "down"
  pid_files(pid_root).each do |path|
    pid = Integer(File.read(path).strip, 10) rescue nil
    kill_pid(pid) if pid
  end
  remove_pid_files(pid_root)
  if system("docker", "info", out: File::NULL, err: File::NULL)
    system("docker", "stop", container, out: File::NULL, err: File::NULL)
  end
  puts "APPly stopped. Persistent PostgreSQL storage was preserved."
when "restart"
  system(RbConfig.ruby, __FILE__, "down")
  exec(RbConfig.ruby, __FILE__, "up", *ARGV)
when "doctor"
  if Gem.win_platform?
    exec("powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", File.join(root, "bin/doctor.ps1"))
  else
    exec(RbConfig.ruby, File.join(root, "bin/doctor"))
  end
else
  puts <<~USAGE
    Usage: apply <command>

    Commands:
      up       Start Docker/PostgreSQL, Rails and Vite in the background
      down     Stop APPly services and PostgreSQL without deleting data
      restart  Run down followed by up
      doctor   Diagnose local dependencies, ports and service health

    Options for up/restart: --seed, --no-browser
  USAGE
  exit(command ? 1 : 0)
end