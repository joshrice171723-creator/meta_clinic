#!/usr/bin/env python3
"""Create a canonical repository Agent Skill without overwriting an existing skill."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
CANONICAL_ROOT = ROOT / ".agents" / "skills"
NAME = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
UNFINISHED = re.compile(r"\b(?:TODO|TBD|PLACEHOLDER)\b", re.IGNORECASE)


def yaml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def compact_description(value: str) -> str:
    normalized = " ".join(value.split())
    if not normalized:
        raise ValueError("description must not be empty")
    if len(normalized) > 1024:
        raise ValueError("description must be 1024 characters or fewer")
    return normalized


def display_name_for(name: str, supplied: str | None) -> str:
    value = supplied.strip() if supplied else name.replace("-", " ").title()
    if not value or "\n" in value:
        raise ValueError("display name must be one non-empty line")
    return value


def short_description(description: str) -> str:
    first_sentence = re.split(r"(?<=[.!?])\s", description, maxsplit=1)[0]
    return first_sentence[:96].rstrip()


def skill_markdown(name: str, description: str, body: str) -> str:
    return (
        "---\n"
        f"name: {name}\n"
        f"description: {yaml_string(description)}\n"
        "---\n\n"
        f"{body.rstrip()}\n"
    )


def openai_yaml(display_name: str, description: str, explicit_only: bool) -> str:
    content = (
        "interface:\n"
        f"  display_name: {yaml_string(display_name)}\n"
        f"  short_description: {yaml_string(short_description(description))}\n"
    )
    if explicit_only:
        content += "policy:\n  allow_implicit_invocation: false\n"
    return content


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", help="Kebab-case skill name")
    parser.add_argument("--description", required=True, help="Skill trigger description")
    parser.add_argument(
        "--body-file",
        required=True,
        type=Path,
        help="UTF-8 Markdown body without YAML frontmatter",
    )
    parser.add_argument("--display-name", help="Optional UI display name")
    parser.add_argument(
        "--explicit-only",
        action="store_true",
        help="Disable implicit invocation in Codex metadata",
    )
    args = parser.parse_args()

    if not NAME.fullmatch(args.name) or len(args.name) > 63:
        parser.error("name must be kebab-case, contain only lowercase letters/digits, and be under 64 characters")

    try:
        description = compact_description(args.description)
        display_name = display_name_for(args.name, args.display_name)
        body = args.body_file.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError, ValueError) as error:
        parser.error(str(error))

    if not body:
        parser.error("body file must not be empty")
    if body.startswith("---"):
        parser.error("body file must not include YAML frontmatter")
    if UNFINISHED.search(body):
        parser.error("body file contains an unfinished TODO/TBD/PLACEHOLDER marker")

    canonical = CANONICAL_ROOT / args.name
    if canonical.exists():
        parser.error(f"refusing to overwrite existing skill for {args.name!r}")

    try:
        (canonical / "agents").mkdir(parents=True)
        (canonical / "SKILL.md").write_text(
            skill_markdown(args.name, description, body), encoding="utf-8"
        )
        (canonical / "agents" / "openai.yaml").write_text(
            openai_yaml(display_name, description, args.explicit_only), encoding="utf-8"
        )
    except OSError as error:
        for path in ((canonical / "agents" / "openai.yaml"), (canonical / "SKILL.md")):
            path.unlink(missing_ok=True)
        for path in (canonical / "agents", canonical):
            try:
                path.rmdir()
            except OSError:
                pass
        print(f"failed to create skill: {error}", file=sys.stderr)
        return 1

    print(f"Created .agents/skills/{args.name}.")
    print("Review the content, then run bin/verify-agent-harness.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
