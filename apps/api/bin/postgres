#!/usr/bin/env ruby
# Local synthetic development only. No hosted credentials and no automatic reset.
require "fileutils"
require "rbconfig"
require "securerandom"
root = File.expand_path("..", __dir__)
path = File.join(root, "tmp", "postgres-password")
name = ENV.fetch("APPLY_POSTGRES_CONTAINER", "apply-postgres-development")
abort "Invalid container name" unless name.match?(/\Aapply-[a-z0-9-]+\z/)

def command_available?(command)
  if Gem.win_platform?
    system("where", command, out: File::NULL, err: File::NULL)
  else
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |directory|
      File.executable?(File.join(directory, command))
    end
  end
end

case ARGV.first
when "start"
  FileUtils.mkdir_p(File.dirname(path))
  if !File.exist?(path) && system("docker", "volume", "inspect", name, out: File::NULL, err: File::NULL)
    abort "Existing PostgreSQL storage has no local credential file. Recover that credential; do not reset or regenerate it."
  end
  File.write(path, SecureRandom.hex(32), mode: "wx", perm: 0o600) unless File.exist?(path)
  if system("docker", "container", "inspect", name, out: File::NULL, err: File::NULL)
    system("docker", "start", name, exception: true, out: File::NULL)
  else
    system("docker", "run", "-d", "--name", name, "--restart", "unless-stopped",
      "--publish", "127.0.0.1:#{ENV.fetch('PGPORT', '54329')}:5432", "--mount", "type=volume,src=#{name},dst=/var/lib/postgresql",
      "--mount", "type=bind,src=#{path},dst=/run/postgres-password,readonly", "-e", "POSTGRES_PASSWORD_FILE=/run/postgres-password",
      "-e", "POSTGRES_DB=apply_development", "postgres:18.6", exception: true, out: File::NULL)
  end
  puts "Local PostgreSQL started; use bin/postgres exec COMMAND. The named volume is persistent."
when "exec"
  abort "Start PostgreSQL first" unless File.file?(path)
  abort "Supply a command" unless ARGV.length > 1
  command = ARGV.drop(1)
  inline_environment = {}
  if Gem.win_platform? && command.first == "env"
    command.shift
    while command.first&.match?(/\A[A-Za-z_][A-Za-z0-9_]*=/)
      key, value = command.shift.split("=", 2)
      inline_environment[key] = value
    end
  end
  if Gem.win_platform?
    script = File.expand_path(command.first, root)
    shebang = File.file?(script) ? File.open(script, &:gets).to_s : ""
    interpreter = if shebang.include?("python")
      "python"
    elsif shebang.include?("ruby")
      RbConfig.ruby
    end
    command = [ interpreter, script, *command.drop(1) ] if interpreter
  end
  database_clients = %w[createdb dropdb psql pg_dump pg_restore pg_isready]
  client_wrapper = ENV["APPLY_POSTGRES_CLIENT_WRAPPER"] == "1"
  if database_clients.include?(command.first) && (client_wrapper || !command_available?(command.first))
    docker_args = [ "exec", "-i" ]
    docker_args.push("-e", "PGUSER=postgres")
    %w[PGDATABASE PGOPTIONS].each do |key|
      docker_args.push("-e", "#{key}=#{ENV[key]}") if ENV[key]
    end
    docker_args << name
    exec("docker", *docker_args, command.first, *command.drop(1))
  end
  environment = {
    "PGHOST" => "127.0.0.1",
    "PGPORT" => ENV.fetch("PGPORT", "54329"),
    "PGUSER" => "postgres",
    "PGPASSWORD" => File.read(path),
    "PATH" => [ File.join(root, "bin"), ENV["PATH"] ].compact.join(File::PATH_SEPARATOR)
  }.merge(inline_environment)
  exec(environment, *command)
when "stop"
  system("docker", "stop", name, exception: true, out: File::NULL)
else
  abort "Usage: bin/postgres start | exec COMMAND... | stop (never deletes data)"
end
