#!/usr/bin/env ruby
# One-time, synthetic-only import into an EMPTY PostgreSQL schema at version 004.
# Rails models are deliberately not loaded: encrypted bytes and IDs are retained.
require "pg"
require "json"
require "open3"
require "time"

abort "Usage: bin/import-legacy-sqlite --synthetic SOURCE_BACKUP (PG* destination required)" unless ARGV.size == 2 && ARGV.first == "--synthetic"
abort "Set explicit PGHOST, PGPORT, PGUSER and PGDATABASE" unless %w[PGHOST PGPORT PGUSER PGDATABASE].all? { |key| ENV[key] && !ENV[key].empty? }
tables = %w[users member_sessions materials contact_messages learning_progresses paperworks clinic_practices clinic_memberships clinic_patients clinic_notes clinic_items clinic_stock_movements clinic_staff_members clinic_pharmacy_products clinic_pharmacy_batches clinic_pharmacy_movements clinic_pharmacy_batch_events]
versions = (1..4).map { |n| "20260830000#{n}00" }
reader = <<~PYTHON
  import sqlite3,json,sys,pathlib,hashlib
  source=pathlib.Path(sys.argv[1]).resolve(strict=True)
  if any(pathlib.Path(str(source)+suffix).exists() for suffix in ('-wal','-shm','-journal')):
      raise RuntimeError('Use an offline SQLite backup without sidecars')
  before=hashlib.sha256(source.read_bytes()).hexdigest()
  db=sqlite3.connect(source.as_uri()+'?mode=ro&immutable=1',uri=True)
  if db.execute('PRAGMA integrity_check').fetchall()!=[('ok',)] or db.execute('PRAGMA foreign_key_check').fetchall():
      raise RuntimeError('Source integrity check failed')
  tables=json.loads(sys.argv[2])
  actual={r[0] for r in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
  if actual != set(tables)|{'sqlite_sequence','schema_migrations','ar_internal_metadata'}:
      raise RuntimeError('Unexpected source schema')
  print(json.dumps({'versions':[r[0] for r in db.execute('SELECT version FROM schema_migrations ORDER BY version')]}),flush=True)
  for table in tables:
      columns=[r[1] for r in db.execute('PRAGMA table_info('+table+')')]
      print(json.dumps({'table':table,'columns':columns}),flush=True)
      for row in db.execute('SELECT * FROM '+table+' ORDER BY id'):
          print(json.dumps({'row':row}),flush=True)
  if hashlib.sha256(source.read_bytes()).hexdigest()!=before:
      raise RuntimeError('Source changed during import')
  print(json.dumps({'complete':True}),flush=True)
PYTHON

begin
  database = PG.connect
  database.exec("SET statement_timeout='30s'; SET lock_timeout='5s'; SET timezone='UTC'")
  normalize = lambda do |value, type|
    if value.nil?
      nil
    elsif type == "boolean"
      raise "Invalid legacy boolean" unless [ true, false, 0, 1, "t", "f" ].include?(value)
      [ true, 1, "t" ].include?(value) ? "t" : "f"
    elsif type.start_with?("timestamp")
      Time.parse("#{value} UTC").utc.iso8601(6)
    else
      value.to_s
    end
  end
  count = 0
  database.transaction do
    database.exec("SELECT pg_advisory_xact_lock(814004)")
    raise "Destination must have exactly the four legacy migrations" unless database.exec("SELECT version FROM schema_migrations ORDER BY version").column_values(0) == versions
    actual = database.exec("SELECT tablename FROM pg_tables WHERE schemaname='public'").column_values(0)
    raise "Unexpected destination schema" unless actual.sort == (tables + %w[schema_migrations ar_internal_metadata]).sort
    database.exec("LOCK TABLE #{tables.join(',')} IN ACCESS EXCLUSIVE MODE")
    raise "Destination is not empty" if tables.any? { |table| database.exec("SELECT 1 FROM #{table} LIMIT 1").ntuples.positive? }
    Open3.popen3("python3", "-c", reader, ARGV.last, JSON.generate(tables)) do |input, output, errors, process|
      input.close
      # Drain errors without echoing source paths, row values or connection data.
      error_reader = Thread.new { errors.read }
      complete = false
      table = columns = types = nil
      seen = []
      output.each_line do |line|
        record = JSON.parse(line)
        if record.key?("versions")
          raise "Unsupported source migration history" unless record["versions"] == versions
        elsif record.key?("table")
          table, columns = record.values_at("table", "columns")
          raise "Unexpected table order" unless table == tables[seen.length]
          seen << table
          metadata = database.exec_params("SELECT column_name,data_type FROM information_schema.columns WHERE table_schema='public' AND table_name=$1 ORDER BY ordinal_position", [ table ])
          types = metadata.to_h { |column| [ column["column_name"], column["data_type"] ] }
          raise "Column mismatch" unless columns == types.keys
        elsif record.key?("row")
          values = record["row"].each_with_index.map { |value, index| normalize.call(value, types.fetch(columns[index])) }
          names = columns.map { |name| database.quote_ident(name) }.join(",")
          placeholders = values.each_index.map { |index| "$#{index + 1}" }.join(",")
          result = database.exec_params("INSERT INTO #{table} (#{names}) VALUES (#{placeholders}) RETURNING #{names}", values).first
          actual = columns.map { |name| normalize.call(result.fetch(name), types.fetch(name)) }
          raise "Row round-trip mismatch" unless actual == values
          count += 1
        elsif record["complete"]
          complete = true
        end
      end
      error_reader.join
      raise "Source read failed" unless process.value.success? && complete && seen == tables
    end
    tables.each do |table|
      database.exec("SELECT setval(pg_get_serial_sequence('#{table}','id'),COALESCE(MAX(id),1),COUNT(*)>0) FROM #{table}")
    end
  end
  puts "Imported and round-trip verified #{count} synthetic rows across #{tables.size} tables. Source unchanged. Run PostgreSQL migrations next."
rescue StandardError
  abort "Import refused or failed; destination rows rolled back. No source data changed. Review schema, empty destination and authorized backup; details suppressed."
ensure
  database&.close
end
