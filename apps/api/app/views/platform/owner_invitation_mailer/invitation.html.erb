<!doctype html>
<html lang="en">
  <body style="margin:0;background:#f4f3ed;color:#173f36;font-family:Arial,sans-serif;">
    <div style="max-width:600px;margin:0 auto;padding:40px 24px;">
      <p style="margin:0 0 32px;font-size:22px;font-weight:700;">Meta Clinic.</p>
      <div style="background:#ffffff;border:1px solid #d9ded7;border-radius:14px;padding:32px;">
        <h1 style="margin:0 0 16px;font-family:Georgia,serif;font-size:32px;line-height:1.15;">Create your owner password</h1>
        <p style="margin:0 0 24px;line-height:1.6;color:#425d55;">
          This private invitation establishes your Meta Clinic platform-owner account.
        </p>
        <p style="margin:0 0 28px;">
          <a href="<%= @activation_url %>" style="display:inline-block;background:#1f5749;color:#ffffff;text-decoration:none;font-weight:700;padding:13px 20px;border-radius:8px;">Create password</a>
        </p>
        <p style="margin:0;font-size:14px;line-height:1.6;color:#63756f;">
          The link expires at <%= @expires_at.in_time_zone("America/Chicago").strftime("%B %-d, %Y at %-I:%M %p %Z") %> and can be used once. After setup, Meta Clinic will sign you in and open the Owner Command Center.
        </p>
      </div>
      <p style="margin:20px 0 0;font-size:13px;line-height:1.5;color:#687872;">If you did not request this account, do not use the link.</p>
    </div>
  </body>
</html>
