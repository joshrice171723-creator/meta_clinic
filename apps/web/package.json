{
  "name": "@apply/web",
  "version": "0.2.4",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "pnpm run typecheck && pnpm run build:bundle",
    "build:bundle": "vite build && vite build --config vite.office.config.ts",
    "browser:smoke": "node scripts/browser-smoke.mjs",
    "browser:acceptance": "node scripts/browser-acceptance.mjs",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src test scripts *.json *.md vite.config.ts index.html --end-of-line auto",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twilio-video": "^2.35.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "playwright-core": "latest",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
