#!/usr/bin/env ruby
# frozen_string_literal: true

# Compatibility shim. The canonical lifecycle is bin/dev.
require "rbconfig"

root = File.expand_path(__dir__)
canonical = File.join(root, "bin", "dev")
requested = ARGV.shift || "start"
commands = {
  "start" => "start", "up" => "start", "restart" => "restart",
  "stop" => "stop", "down" => "stop", "status" => "status", "doctor" => "status"
}.freeze

exec(RbConfig.ruby, canonical, "help", chdir: root) if %w[help --help -h].include?(requested)
command = commands[requested]
abort "Unknown command: #{requested}. Run bin/dev help." unless command

legacy_seed = ARGV.delete("--seed")
ARGV.delete("--no-seed-refresh")
if legacy_seed
  success = system(RbConfig.ruby, canonical, "reset-data", "--yes", chdir: root)
  exit 1 unless success
  command = "start"
end

warn "dev_server_startup is deprecated; use bin/dev #{command}."
exec(RbConfig.ruby, canonical, command, *ARGV, chdir: root)
