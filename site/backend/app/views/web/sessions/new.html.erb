<% content_for :title, "Member login — APPly" %>
<main id="main" class="wrap inner-page login-layout">
  <div class="inner-page-copy"><p class="eyebrow">YOUR NEXT CHAPTER, ORGANIZED</p><h1>Your launch.<br><em>One place to start.</em></h1><p>Sign in to review your paperwork and work through onboarding and training.</p><p class="page-fine-print">APPly provides your account after payment. There is no public signup. Need access help? <a href="/contact">Contact us.</a></p></div>
  <section class="form-card login-card"><h2>Welcome back.</h2><p class="form-intro">Use the login provided by APPly.</p>
    <%= form_with url: login_path do |form| %>
      <div class="form-field"><%= form.label :email_address, "Email address" %><%= form.email_field :email_address, required: true, maxlength: 254, autocomplete: "username" %></div>
      <div class="form-field"><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password" %></div>
      <%= form.submit "Sign in", class: "primary-link form-submit" %>
    <% end %>
    <% if DevelopmentAccess.allowed?(request) %>
      <hr><%= button_to "Continue as demo client", development_login_path, class: "button form-submit" %>
      <p class="form-note">Development only. Creates a fresh synthetic walkthrough. No password or ChatGPT sign-in needed.</p>
    <% end %>
  </section>
</main>
