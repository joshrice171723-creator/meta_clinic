<div class="portal-navigation">
  <nav aria-label="Launch navigation">
    <% [["My launch", portal_path], ["Paperwork", paperwork_index_path], ["Onboarding & Training", training_index_path]].each do |label, path| %>
      <%= link_to label, path, aria: { current: (request.path == path || (path != portal_path && request.path.start_with?(path + "/"))) ? "page" : nil } %>
    <% end %>
    <% if current_user.admin? %><%= link_to "Inquiries", inquiries_path %><% end %>
  </nav>
  <div class="member-actions"><a href="/clinic" class="workspace-switch">Clinic workspace ↗</a><%= button_to "Sign out", logout_path, class: "button" %></div>
</div>
<% if development_demo? %><p class="demo-notice">Local development walkthrough. Use fictional information only. This is your launch portal, not the clinic operations workspace.</p><% end %>
