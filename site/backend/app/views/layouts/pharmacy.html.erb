<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title).presence || "Pharmacy — APPly" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <link rel="icon" href="/favicon.svg"><link rel="stylesheet" href="/pharmacy.css">
</head>
<body class="rx-shell">
  <a class="skip-link" href="#main">Skip to content</a>
  <aside class="rx-sidebar">
    <a href="/clinic" class="rx-brand" aria-label="Clinic workspace home"><span class="rx-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span><strong>APPly</strong><small>pharmacy operations</small></span></a>
    <div class="rx-clinic"><span class="rx-dot" aria-hidden="true"></span><div><small>Assigned clinic</small><strong><%= current_practice&.name || "Clinic access" %></strong></div></div>
    <% if clinic_membership&.inventory_access? %>
      <nav class="rx-nav" aria-label="Pharmacy navigation"><p>Workspace</p>
        <% %w[dashboard inventory movements alerts suppliers].each do |section| %>
          <%= link_to clinic_pharmacy_index_path(view: section), aria: { current: pharmacy_section == section ? "page" : nil } do %>
            <%= pharmacy_icon(section) %><span><%= section.humanize %></span><% if section == "alerts" && @alert_count.to_i.positive? %><b><%= @alert_count %></b><% end %>
          <% end %>
        <% end %>
      </nav>
    <% end %>
    <nav class="rx-nav rx-other-nav" aria-label="Other clinic sections"><p>Clinic workspace</p>
      <%= link_to clinic_root_path do %><%= pharmacy_icon("clinic") %><span>Clinic overview</span><% end %>
      <% if clinic_membership&.patients_access? %><%= link_to "Patient records", clinic_patients_path %><% end %>
      <% if clinic_membership&.inventory_access? %><%= link_to "Office supplies", clinic_inventory_index_path %><% end %>
      <% if clinic_membership&.staff_access? %><%= link_to "Employees", clinic_staff_index_path %><% end %>
    </nav>
    <div class="rx-sidebar-bottom"><a href="/portal">← Launch &amp; onboarding</a><div class="rx-session"><span class="rx-avatar" aria-hidden="true">TC</span><div><strong><%= development_demo? ? "Local demo session" : "Clinic workspace" %></strong><small>Synthetic inventory only</small></div></div><%= button_to "Sign out", logout_path, class: "rx-sign-out" if current_user %></div>
  </aside>
  <div class="rx-main">
    <header class="rx-topbar"><div><a href="/clinic">Clinic workspace</a><span aria-hidden="true">/</span><strong>Pharmacy</strong></div><span class="rx-prototype"><span class="rx-dot" aria-hidden="true"></span>Local prototype</span></header>
    <div class="rx-safety">SYNTHETIC ONLY <span>Use fictional stock. No patients, prescribing or dispensing. Counts are whole packages, never doses.</span></div>
    <% if flash[:notice] %><div class="rx-flash" role="status"><%= flash[:notice] %></div><% end %>
    <% if flash[:alert] %><div class="rx-flash rx-error" role="alert"><%= flash[:alert] %></div><% end %>
    <%= yield %>
  </div>
</body>
</html>
