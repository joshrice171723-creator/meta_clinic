<!DOCTYPE html>
<html lang="en">
<head>
  <title><%= content_for(:title).presence || "APPly — Your clinic. A supported start." %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="Clinic launch support for NPs and PAs in Sherman and North Texas.">
  <meta name="robots" content="noindex, nofollow">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <% if controller_name == "pages" && action_name == "home" %>
    <link rel="canonical" href="<%= site_origin %>/">
    <meta property="og:title" content="APPly — Your clinic. A supported start.">
    <meta property="og:description" content="Clinic launch support for NPs &amp; PAs in Sherman and North Texas.">
    <meta property="og:type" content="website"><meta property="og:url" content="<%= site_origin %>/">
    <meta property="og:image" content="<%= site_origin %>/og.png">
    <meta property="og:image:width" content="1732"><meta property="og:image:height" content="908">
    <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="APPly — Your clinic. A supported start.">
    <meta name="twitter:description" content="Clinic launch support for NPs &amp; PAs in Sherman and North Texas.">
    <meta name="twitter:image" content="<%= site_origin %>/og.png">
  <% end %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/application.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap">
    <a class="wordmark" href="/" aria-label="APPly home">APPly<span class="brand-dot"></span></a>
    <nav aria-label="Main navigation">
      <a href="/#approach">The approach</a><a href="/#process">How it works</a>
      <a class="login-link" href="<%= current_user ? portal_path : login_path %>"><%= current_user ? "My launch" : "Member login" %></a>
      <a class="nav-cta" href="/contact">Contact us <span aria-hidden="true">↗</span></a>
    </nav>
  </header>
  <% if current_user && development_demo? %>
    <div class="wrap"><div class="demo-notice session-notice"><span>Development demo session · You are already signed in.</span><%= button_to "Sign out", logout_path, class: "button" %></div></div>
  <% end %>
  <%= render "web/shared/flash" %>
  <%= yield %>
  <footer class="wrap footer-wrap">
    <div class="site-footer"><a class="wordmark" href="/">APPly<span class="brand-dot"></span></a><span>Independent practices. A supported start.</span>
      <div class="footer-links"><a href="/contact">Contact</a><a href="/login">Member login</a><a href="/clinic">Clinic workspace</a><span>Sherman &amp; North Texas</span></div>
    </div>
    <div class="footer-bottom"><p>Clinic-launch consulting. Not legal or clinical advice. No guarantee of approval or opening date.</p><span>© <%= Date.current.year %> APPly</span></div>
  </footer>
</body>
</html>
