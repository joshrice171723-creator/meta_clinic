<section class="rx-panel" id="attention"><div class="rx-panel-heading"><div><p class="rx-eyebrow rx-coral">Action queue</p><h2>Needs attention <span class="rx-count"><%= @alert_count %></span></h2></div><% if compact %><%= link_to "See queue →", clinic_pharmacy_index_path(view: "alerts"), class: "rx-link" %><% end %></div>
  <% @low_stock.first(compact ? 2 : @low_stock.length).each do |product| %><article class="rx-alert"><span class="rx-alert-marker" aria-hidden="true"></span><div><strong><%= link_to product.name, clinic_pharmacy_path(product) %> · Low stock</strong><p><%= product.available_quantity %> available packages · reorder at <%= product.reorder_point %></p></div><%= link_to "Review", clinic_pharmacy_path(product), class: "rx-link", aria: { label: "Review low stock for #{product.name}" } %></article><% end %>
  <% @attention.first(compact ? 2 : @attention.length).each do |batch| %><article class="rx-alert"><span class="rx-alert-marker <%= 'urgent' unless batch.available? %>" aria-hidden="true"></span><div><strong><%= link_to batch.product.name, clinic_pharmacy_path(batch.product) %> · <%= batch.expiring? ? "Expiring soon" : batch.display_status.humanize %></strong><p><%= batch.lot_number %> · <%= batch.quantity %> packages · expires <%= batch.expires_on %></p></div><%= link_to "Review", clinic_pharmacy_path(batch.product), class: "rx-link", aria: { label: "Review lot #{batch.lot_number}" } %></article><% end %>
  <% if @alert_count.zero? %><div class="rx-empty"><h3>No current stock exceptions.</h3><p>Alerts appear as recorded stock or dates change.</p></div><% end %>
</section>
