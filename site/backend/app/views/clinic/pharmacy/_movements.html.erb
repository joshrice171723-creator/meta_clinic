<section class="rx-panel"><div class="rx-panel-heading"><div><p class="rx-eyebrow">Stock ledger</p><h2><%= compact ? "Recent movements" : "Movement history" %></h2></div><% if compact %><%= link_to "View all →", clinic_pharmacy_index_path(view: "movements"), class: "rx-link" %><% end %></div>
  <% if movements.empty? %><div class="rx-empty"><h3>No movements yet.</h3><p>Open a product and receive a fictional lot to begin.</p><%= link_to "Open inventory", clinic_pharmacy_index_path(view: "inventory"), class: "rx-link" %></div><% end %>
  <% movements.each do |movement| %><article class="rx-movement"><span class="rx-movement-icon <%= movement.quantity.positive? ? 'positive' : 'negative' %>" aria-hidden="true"><%= pharmacy_icon(movement.quantity.positive? ? "plus" : "movements") %></span><div class="rx-movement-copy"><strong><%= link_to movement.batch.product.name, clinic_pharmacy_path(movement.batch.product) %></strong><span><%= movement.kind.humanize %> · <%= movement.batch.lot_number %></span><% unless compact %><p><%= movement.reason %></p><span><%= movement.batch.location %> · Account <%= movement.actor_id %></span><% end %></div><strong class="rx-quantity <%= 'positive' if movement.quantity.positive? %>"><%= "%+d" % movement.quantity %></strong><time datetime="<%= movement.created_at.iso8601 %>"><%= movement.created_at.utc.strftime("%b %-d") %><small><%= movement.created_at.utc.strftime("%H:%M UTC") %></small></time></article><% end %>
  <% unless compact %><p class="rx-caption">Latest 30 movements. Whole packages · UTC. Older entries remain in each lot’s history.</p><% end %>
</section>
