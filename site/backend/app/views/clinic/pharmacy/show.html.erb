<% content_for :title, "Pharmacy product — APPly" %>
<main id="main" class="rx-content">
  <%= link_to "← Pharmacy inventory", clinic_pharmacy_index_path, class: "text-link" %>
  <div class="rx-page-heading"><div><p class="rx-eyebrow">PACKAGE CATALOG · <%= @product.sku %></p><h1><%= @product.name %></h1><p class="rx-subtitle"><%= [@product.generic_name, @product.dosage_form, @product.route].compact_blank.join(" · ") %></p></div><span class="rx-pill positive"><%= @product.active? ? "Active catalog product" : "Inactive product" %></span></div>
  <section class="rx-panel rx-spaced"><div class="rx-panel-heading"><h2>Package reference</h2><%= link_to "Receive stock ↓", clinic_pharmacy_path(@product, panel: "receive", anchor: "receive"), class: "rx-button rx-primary" %></div>
    <p><%= @product.package_description.presence || "No package description supplied." %></p><p><%= @product.ingredients %></p>
    <% if @product.source == "openfda" %><p>NDC <strong><%= @product.ndc %></strong> · Product NDC <%= @product.product_ndc %><br>Labeler: <%= @product.labeler %> · Imported <%= @product.imported_at.utc.strftime("%Y-%m-%d %H:%M UTC") %></p><p class="rx-caption">Public FDA listing reference; not verification or approval. Confirm the physical package before receiving. No clinical decision or prescription is created.</p><% else %><p class="rx-caption">Manual / fictional reference. No FDA lookup or NDC verification is implied.</p><% end %>
    <details class="rx-details"><summary>Edit reorder point &amp; catalog state</summary>
    <%= form_with model: @product, url: clinic_pharmacy_path(@product), class: "pharmacy-search" do |form| %>
      <div class="form-field"><%= form.label :reorder_point, "Reorder point (whole packages)" %><%= form.number_field :reorder_point, min: 0, max: 1000000, required: true, step: 1 %></div>
      <div class="form-field"><%= form.label :active, "Catalog state" %><%= form.select :active, [["Active", true], ["Inactive — retain history", false]] %></div><%= form.submit "Save settings", class: "button" %>
    <% end %></details>
  </section>
  <div class="rx-stat-grid rx-three-stats"><div class="rx-stat"><span>Available</span><strong><%= @product.available_quantity %></strong><small>Whole packages</small></div><div class="rx-stat"><span>On hand</span><strong><%= @product.on_hand_quantity %></strong><small>Includes held and expired packages</small></div><div class="rx-stat"><span>Lots / locations</span><strong><%= @product.batches.length %></strong><small>Each receipt is traceable</small></div></div>
  <section class="rx-panel rx-spaced" id="receive"><details class="rx-receive" <%= 'open' if @product.batches.empty? || params[:panel] == 'receive' %>><summary>Receive a fictional lot</summary><p>Use a distinct lot/location pair. For a repeat delivery of the same lot, add a receipt to its existing ledger below. Counts are sealed packages, not doses or dispensing units.</p>
    <%= form_with url: receive_clinic_pharmacy_path(@product), class: "pharmacy-form-grid" do |form| %>
      <%= form.hidden_field :request_key, value: SecureRandom.uuid %>
      <div class="form-field"><%= label_tag "batch_lot_number", "Fictional lot number" %><%= text_field_tag "batch[lot_number]", nil, required: true, maxlength: 100 %></div>
      <div class="form-field"><%= label_tag "batch_expires_on", "Expiry date" %><%= date_field_tag "batch[expires_on]", nil, required: true %></div>
      <div class="form-field"><%= label_tag "batch_location", "Fictional storage location" %><%= text_field_tag "batch[location]", nil, required: true, maxlength: 100, placeholder: "Test stockroom" %></div>
      <div class="form-field"><%= label_tag "batch_supplier", "Fictional supplier (optional)" %><%= text_field_tag "batch[supplier]", nil, maxlength: 120 %></div>
      <div class="form-field"><%= form.label :amount, "Whole packages received" %><%= form.number_field :amount, required: true, min: 1, max: 1000000, step: 1 %></div>
      <div class="form-field"><%= form.label :reason, "Receipt reason / non-patient reference" %><%= form.text_field :reason, required: true, maxlength: 200 %></div>
      <div><%= form.submit "Record fictional receipt", class: "primary-link", disabled: !@product.active? %></div>
    <% end %></details>
  </section>
  <section><div class="rx-panel-heading"><h2>Lots, expiry &amp; history</h2><span class="rx-caption">Earliest expiry first</span></div><p class="rx-subtitle">Earliest expiry first. Expired, quarantined, recalled and inactive stock is excluded from availability. Dates use UTC; expiry is flagged after the recorded date.</p>
    <% if @product.batches.empty? %><p>No lots received yet.</p><% end %>
    <% @product.batches.sort_by(&:expires_on).each do |batch| %>
      <article class="rx-panel rx-spaced" id="lot-<%= batch.id %>"><div class="rx-panel-heading"><h2>Lot <%= batch.lot_number %> · <%= batch.location %></h2><span class="rx-pill <%= batch.available? ? 'positive' : 'danger' %>"><%= batch.display_status.humanize %></span></div><p><strong><%= batch.quantity %> packages on hand</strong> · Expires <%= batch.expires_on %> · Supplier: <%= batch.supplier.presence || "Not supplied" %></p>
        <details class="rx-details"><summary>Record a stock movement</summary>
          <%= form_with url: clinic_pharmacy_movement_path(batch), class: "pharmacy-form-grid" do |form| %>
            <%= form.hidden_field :request_key, value: SecureRandom.uuid %>
            <div class="form-field"><%= form.label :kind, "Movement", for: "kind_#{batch.id}" %><%= form.select :kind, Clinic::PharmacyMovement::KINDS.keys.map { |kind| [kind.humanize, kind] }, {}, id: "kind_#{batch.id}" %></div>
            <div class="form-field"><%= form.label :amount, "Whole packages", for: "amount_#{batch.id}" %><%= form.number_field :amount, id: "amount_#{batch.id}", min: 1, max: 1000000, step: 1, required: true %></div>
            <div class="form-field rx-wide"><%= form.label :reason, "Reason — no patient references", for: "reason_#{batch.id}" %><%= form.text_field :reason, id: "reason_#{batch.id}", required: true, maxlength: 200 %></div><div><%= form.submit "Record movement", class: "button" %></div>
          <% end %>
        </details>
        <details class="rx-details"><summary>Quarantine, recall or release this fictional lot</summary>
          <p>Changes availability without changing package count. This synthetic review is recorded with your account and reason; it is not regulatory or clinical clearance.</p>
          <%= form_with url: clinic_pharmacy_batch_status_path(batch), class: "pharmacy-form-grid" do |form| %>
            <%= form.hidden_field :request_key, value: SecureRandom.uuid %>
            <div class="form-field"><%= form.label :status, "Reviewed state", for: "status_#{batch.id}" %><%= form.select :status, Clinic::PharmacyBatch::STATUSES.map { |status| [status.humanize, status] }, { selected: batch.status }, id: "status_#{batch.id}" %></div>
            <div class="form-field"><%= form.label :reason, "Review reason", for: "status_reason_#{batch.id}" %><%= form.text_field :reason, id: "status_reason_#{batch.id}", required: true, maxlength: 200 %></div><div><%= form.submit "Record status review", class: "button" %></div>
          <% end %>
        </details>
        <details class="rx-details"><summary>View append-only history (<%= batch.movements.length + batch.events.length %>)</summary>
          <div class="rx-table-wrap"><table><thead><tr><th scope="col">UTC</th><th scope="col">Event</th><th scope="col">Packages</th><th scope="col">Reason</th><th scope="col">Account</th></tr></thead><tbody>
            <% (batch.movements.to_a + batch.events.to_a).sort_by(&:created_at).reverse_each do |event| %><tr><td><%= event.created_at.utc.strftime("%Y-%m-%d %H:%M") %></td><td><%= event.is_a?(Clinic::PharmacyMovement) ? event.kind.humanize : "#{event.from_status.humanize} → #{event.to_status.humanize}" %></td><td><%= event.is_a?(Clinic::PharmacyMovement) ? "%+d" % event.quantity : "Unchanged" %></td><td><%= event.reason %></td><td><%= event.actor_id %></td></tr><% end %>
          </tbody></table></div>
        </details>
      </article>
    <% end %>
  </section>
</main>
