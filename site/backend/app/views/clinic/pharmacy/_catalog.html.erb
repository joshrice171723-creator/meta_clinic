<% if @products.empty? %>
  <div class="rx-empty"><span class="rx-empty-icon"><%= pharmacy_icon("inventory") %></span><h3>Your pharmacy catalog starts here.</h3><p>Add a product with FDA lookup or manual entry, then receive a fictional lot to add stock.</p><div class="rx-actions"><%= link_to "Add your first product", new_clinic_pharmacy_path, class: "rx-button rx-primary" %><% if development_demo? %><%= button_to "Load fictional pharmacy examples", demo_clinic_pharmacy_index_path, class: "rx-button rx-secondary" %><% end %></div></div>
<% elsif products.empty? %>
  <div class="rx-empty"><h3>No products match these filters.</h3><p>Try a different name, SKU or stock view.</p><%= link_to "Show all products", clinic_pharmacy_index_path(view: "inventory"), class: "rx-button rx-secondary" %></div>
<% else %>
  <div class="rx-table-wrap" tabindex="0" role="region" aria-label="Pharmacy products"><table><thead><tr><th scope="col">Product</th><th scope="col">SKU / NDC</th><th scope="col">Available</th><th scope="col">Location</th><th scope="col">Next expiry</th><th scope="col">Status</th><th scope="col"><span class="sr-only">Open product</span></th></tr></thead><tbody>
    <% products.each_with_index do |product, index| %><% status, tone = pharmacy_status(product) %><% locations = product.batches.select { |batch| batch.quantity.positive? }.map(&:location).uniq %><tr>
      <td><div class="rx-product-cell"><span class="rx-product-avatar tone-<%= index % 5 %>" aria-hidden="true"><%= product.name.first(2).upcase %></span><div><%= link_to product.name, clinic_pharmacy_path(product), class: "rx-product-name" %><small><%= [product.generic_name, product.dosage_form].compact_blank.join(" · ").presence || product.package_description.presence || "Manual product" %></small></div></div></td>
      <td><code><%= product.sku %></code><small><%= product.ndc.presence || "Manual / synthetic" %></small></td>
      <td><strong class="<%= 'rx-low-number' if product.low_stock? %>"><%= product.available_quantity %></strong><small><%= product.on_hand_quantity %> on hand · min <%= product.reorder_point %></small></td>
      <td><%= locations.first || "—" %><% if locations.length > 1 %><small>+<%= locations.length - 1 %> more</small><% end %></td>
      <td><%= product.batches.select { |batch| batch.available? && batch.quantity.positive? }.map(&:expires_on).min&.strftime("%b %-d, %Y") || "—" %></td>
      <td><span class="rx-pill <%= tone %>"><%= status %></span><% if product.batches.any? { |batch| batch.quantity.positive? && !batch.available? } %><small class="rx-low-number">Held / expired stock</small><% end %></td>
      <td><%= link_to clinic_pharmacy_path(product), class: "rx-open-product", aria: { label: "View #{product.name}" } do %><%= pharmacy_icon("arrow") %><% end %></td>
    </tr><% end %>
  </tbody></table></div>
<% end %>
