<% content_for :title, "#{pharmacy_section.humanize} · Pharmacy — APPly" %>
<main id="main" class="rx-content">
  <div class="rx-page-heading">
    <div><p class="rx-eyebrow"><%= Date.current.strftime("%A, %B %-d, %Y") %> <span>—</span> <%= current_practice.name %></p><h1><%= @view == "dashboard" ? "Your pharmacy, at a glance." : @view == "inventory" ? "Pharmacy inventory" : @view.humanize %></h1><p><%= @view == "dashboard" ? "A clear view of your stock and what needs attention." : "Every package, lot and movement in one place." %></p></div>
    <div class="rx-actions"><%= link_to clinic_pharmacy_index_path(view: "inventory", anchor: "catalog"), class: "rx-button rx-secondary" do %><%= pharmacy_icon("movements") %>Record movement<% end %><%= link_to new_clinic_pharmacy_path, class: "rx-button rx-primary" do %><%= pharmacy_icon("plus") %>Add product<% end %></div>
  </div>
  <% if @view == "dashboard" %>
    <section class="rx-pulse"><div><p class="rx-eyebrow"><span class="rx-dot" aria-hidden="true"></span>Inventory pulse</p><h2><%= @alert_count.zero? ? "A fresh view of" : "A little attention" %><br><em><%= @alert_count.zero? ? "every package." : "goes a long way." %></em></h2><p><%= @products.empty? ? "Start with a fictional product or explore sample inventory. Your saved stock will appear here." : "#{pluralize(@low_stock.length, 'product')} at reorder level · #{pluralize(@attention.length, 'lot')} with expiry or availability to review." %></p><%= link_to clinic_pharmacy_index_path(view: @products.empty? ? "inventory" : "alerts"), class: "rx-pulse-link" do %><%= @products.empty? ? "Set up your inventory" : "View attention queue" %><%= pharmacy_icon("arrow") %><% end %></div><div class="rx-pulse-visual" aria-label="#{@available} available packages"><div class="rx-orbit"><div><strong><%= number_with_delimiter(@available) %></strong><small>available packages</small></div></div></div></section>
  <% end %>
  <% if %w[dashboard inventory].include?(@view) %><%= render "stats" %><% end %>
  <% case @view
     when "dashboard" %>
    <% unless @products.empty? %><div class="rx-section-grid"><%= render "movements", movements: @movements.first(4), compact: true %><%= render "alerts", compact: true %></div><% end %>
    <section class="rx-panel" id="catalog"><div class="rx-panel-heading"><div><p class="rx-eyebrow">Catalog overview</p><h2>Inventory at a glance</h2></div><%= link_to "Open inventory →", clinic_pharmacy_index_path(view: "inventory"), class: "rx-link" %></div><%= render "catalog", products: @products.first(5) %></section>
  <% when "inventory" %>
    <section class="rx-panel" id="catalog"><div class="rx-panel-heading"><div><p class="rx-eyebrow">Product catalog</p><h2>Your inventory</h2></div><span class="rx-caption">Select a product to view lots or record a movement</span></div>
      <%= form_with url: clinic_pharmacy_index_path, method: :get, class: "rx-toolbar" do |form| %>
        <%= form.hidden_field :view, value: "inventory" %>
        <div class="rx-search"><%= pharmacy_icon("search") %><%= form.search_field :q, value: @query, maxlength: 100, placeholder: "Search products, SKU or NDC", aria: { label: "Search your local catalog" } %></div>
        <%= form.select :filter, [["All products", "all"], ["Low stock", "low_stock"], ["Expiring in 30 days", "expiring"], ["Held / expired", "held"]], { selected: @filter }, aria: { label: "Stock view" } %>
        <%= form.submit "Filter catalog", class: "rx-button rx-secondary" %><%= link_to "Reset", clinic_pharmacy_index_path(view: "inventory"), class: "rx-link" %>
      <% end %>
      <div class="rx-inventory-meta"><span>Showing <strong><%= @filtered.length %></strong> of <%= @products.length %> products</span><span>Whole-package stock</span></div>
      <%= render "catalog", products: @filtered %>
    </section>
  <% when "movements" %><%= render "movements", movements: @movements, compact: false %>
  <% when "alerts" %><div class="rx-section-grid"><%= render "alerts", compact: false %><section class="rx-panel rx-guide"><p class="rx-eyebrow">Workflow note</p><h2>Keep exceptions visible.</h2><p>Alerts reflect available stock, expiry dates and batch status. They clear when the underlying condition changes.</p><div><strong>Held or expired</strong><p>Physically on hand, excluded from availability. Review the lot and its history.</p></div><div><strong>Low stock or upcoming expiry</strong><p>Review stock before recording a receipt or correction. No orders are placed here.</p></div><p class="rx-caption">No automated recall feed or clinical safety assessment.</p></section></div>
  <% when "suppliers" %>
    <div class="rx-panel-heading"><p class="rx-caption">Supplier names recorded on fictional receipts. These are not verified or approved trading partners.</p></div>
    <div class="rx-supplier-grid"><% @batches.select { |batch| batch.supplier.present? }.group_by(&:supplier).each do |supplier, lots| %><article class="rx-panel"><span class="rx-product-avatar"><%= supplier.first(2).upcase %></span><h2><%= supplier %></h2><p class="rx-caption">Receipt reference</p><div class="rx-supplier-stats"><div><strong><%= lots.map(&:product_id).uniq.length %></strong><span>Products</span></div><div><strong><%= lots.length %></strong><span>Lots / locations</span></div></div><% lots.map(&:product).uniq.each do |product| %><p><%= link_to product.name, clinic_pharmacy_path(product), class: "rx-link" %></p><% end %></article><% end %></div>
    <% unless @batches.any? { |batch| batch.supplier.present? } %><section class="rx-panel rx-empty"><h2>No supplier references yet.</h2><p>Add a fictional supplier while receiving a lot.</p><%= link_to "Open inventory", clinic_pharmacy_index_path(view: "inventory"), class: "rx-button rx-primary" %></section><% end %>
  <% end %>
</main>
