# Non-secret, operator-controlled canonical origin. Set through Sites for hosting.
# For Cloudflare local development, copy these values into ignored .dev.vars.
APP_RUNTIME=development
APP_SITE_ORIGIN=http://localhost:3000
RAILS_BACKEND_URL=http://127.0.0.1:3001
# Production: APP_RUNTIME=production and both origins must be HTTPS.
