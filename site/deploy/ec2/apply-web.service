[Unit]
Description=APPly synthetic Rails staging (clinic routes disabled)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/apply
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
RuntimeDirectory=apply
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f apply-web
ExecStart=/usr/local/sbin/apply-run
ExecStop=/usr/bin/docker stop --time 30 apply-web
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
